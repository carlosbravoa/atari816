#!/usr/bin/env python3
"""hcc - build a Horizon program (Atari816) from C, in one command.

    hcc -o GAME.PRG main.c other.c [more.s] [options]

Compiles every .c with cc816 (the SDK's C compiler, sdk/c/cc816), assembles every .s
(ca65 syntax), links them with ld65 and the Horizon C library and writes GAME.PRG, ready
for the SD card or the emulator (sdk/tools/run816.py). Needs Python 3 and cc65's ca65,
ld65 and ar65. float and double are IEEE 754 single precision (32 bits); long long is 64.

Options:
  -o FILE           the program (default: the first source's name in capitals, .PRG)
  -c                compile/assemble only: one .o per source (with -o: that name)
  -S                write the compiler's assembly (.s) next to each .c, then go on
  -I DIR            look for #include files in DIR too
  -D NAME[=VALUE]   define a macro         -U NAME   undefine one
  -include FILE     include FILE before each source
  -w                no warnings
  -Wall             more warnings (unused variables and labels, x <= 32767 with an
                    int x, if (a = b), a far pointer cast to a near one)
  -Werror           warnings are errors;  -Wno-NAME: one warning off (the NAME is the
                    one printed in [-W...] after the warning)
  -fsigned-char     plain char is signed (-128 to 127); the default is unsigned
  -O0 -O1 -O2 -O3 -Os
                    optimisation: -O2 (the default); -O3 and -Os are the same as -O2;
                    -O1 no loop optimisations, -O0 none
  --code small|large
                    the code model (default: $HZ_CODE, else small). small: the whole
                    program in one 64 KB bank (JSR/RTS). large: code in several banks
                    (JSL/RTL; data, constants and stacks stay in the main bank): still
                    one file, NAME.PRG: the other code banks follow its o65 (it needs
                    Horizon 0.28 then; docs/c/reference.md, "The two code models")
  --data near|far   the data model (default: $HZ_DATA, else near). far (with --code large
                    only): plain data pointers are 32-bit far pointers, malloc takes
                    other banks, string literals and const objects go to banks of far
                    data: DOS's large model (docs/c/reference.md, "The far data model")
  -fdos-keywords    far, near and huge are keywords (as __far, __near, __far)
  --sizes           print every object and function, its size and where it went
                    (main bank, code bank k, far data bank k), biggest first
  --stack N         bytes for the software stack (arrays, structures and locals whose
                    address is taken; default 8192, taken from the main bank)
  --heap N          --code large: bytes of the main bank kept free for malloc (and
                    fopen's 1 KB buffers) when hcc fills it with code (default 4096)
  --bank-room N, --main-room N, --spread N
                    --code large, for tests: at most N bytes of code in each other bank,
                    and in the main bank (--main-room 0: every function that can move
                    goes to another bank); --spread N: the functions in turn in N banks
                    (also $HZ_BANK_ROOM, $HZ_MAIN_ROOM, $HZ_SPREAD)
  --ui              link Horizon's controls library (hui.h: windows with buttons,
                    fields, lists, dialogs); hcc also adds it by itself when the program
                    uses a name of hui.h (docs/c/apps.md)
  --game            link hgame, the game library (sdk/c/game); hcc also does it by
                    itself when a C source includes <hgame.h>, <conio.h> or <joystick.h>
  --needs LIST      what the program needs, checked when it starts (Horizon 0.29's
                    HZ_NEEDS, sdk/docs/apps.md): comma-separated horizon=0.29, rev=11,
                    lau, opl2, sprites, blitter, joystick, mem=1024K (or 2M); repeatable.
                    Missing -> one line on the console, the same in a small window when
                    the window system runs, exit 1 ("GAME needs the OPL2 sound chip
                    (hardware revision $0C)."); this works on older Horizons too. With
                    --code large, horizon is at least 0.28. Without --needs: no check
  --map             write FILE.map (the link map) and FILE.lbl (every label's address:
                    the profiler, prof816.py, reads it) and print the sizes
  --debug           paint the stacks; at exit the program prints how much of both
                    stacks it used, and the most of the heap in use at once
  --no-stack-check  no software-stack check at the entry of the program's functions
                    (by default every function with a frame there checks that it fits,
                    10 cycles, and stops the program with its name when it does not:
                    docs/c/reference.md, "The heap and the stacks"); the library keeps
                    its checks
  -l FILE           link an extra object or library (.o, .lib)
  -lm               accepted and ignored (math.h's functions are in the C library)
  -v                show the commands
  --keep DIR        keep the intermediate links in DIR
  --version, -h

Sizes are checked: a program too big for its code bank is an error that gives the sizes
and what to do.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "tools"))
import hzc816  # noqa: E402
from hzc816 import HccError  # noqa: E402
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "game"))
import hgbuild  # noqa: E402

VERSION = "hcc 3.0 (Horizon C SDK: cc816)"


def die(msg, code=1):
    print(f"hcc: {msg}", file=sys.stderr)
    sys.exit(code)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "--version":
        print(VERSION)
        return 0
    if argv[0] == "--build-lib":            # the SDK's Makefile: (re)build the library
        try:
            for m in argv[1:] or hzc816.LIBS:   # small, large, large-far
                if m not in hzc816.LIBS:
                    die(f"--build-lib takes small, large and large-far, not {m}")
                hzc816.build_lib(code=m)
        except HccError as e:
            die(str(e))
        return 0
    o = {"out": None, "srcs": [], "incs": [], "defs": [], "libs": [], "opt": None,
         "compile_only": False, "asm_too": False, "want_map": False,
         "debug": False, "ui": False, "game": False, "stack": None, "keep": None,
         "code": os.environ.get("HZ_CODE") or "small", "heap": None,
         "data": os.environ.get("HZ_DATA") or "near", "sizes": False,
         "bank_room": _env_int("HZ_BANK_ROOM"), "main_room": _env_int("HZ_MAIN_ROOM"),
         "spread": _env_int("HZ_SPREAD"), "needs": [],
         "ccopts": {"w": False, "wall": False, "werror": False, "wflags": {},
                    "signed_char": False, "undefs": [], "includes": []}}
    i = 0

    def val(name):
        nonlocal i
        if i + 1 >= len(argv):
            die(f"{name} needs a value")
        i += 1
        return argv[i]

    while i < len(argv):
        a = argv[i]
        if a == "-o":
            o["out"] = val("-o")
        elif a == "-c":
            o["compile_only"] = True
        elif a == "-S":
            o["asm_too"] = True
        elif a.startswith("-I"):
            o["incs"].append(a[2:] or val("-I"))
        elif a.startswith("-D"):
            o["defs"].append(a[2:] or val("-D"))
        elif a == "-include":
            o["ccopts"]["includes"].append(val("-include"))
        elif a.startswith("-U"):
            o["defs"].append("-U" + (a[2:] or val("-U")))   # (cc816: in order with -D)
        elif a in ("-fsigned-char", "-fno-unsigned-char"):
            o["ccopts"]["signed_char"] = True
        elif a in ("-funsigned-char", "-fno-signed-char"):
            o["ccopts"]["signed_char"] = False
        elif a == "-w" or (a.startswith("-W") and len(a) > 2):
            from cc816 import driver as _drv     # (tools/hzc816.py put cc816 on the path)
            _drv.parse_warning_flag(a, o["ccopts"])
        elif a.startswith("-O"):
            v = a[2:] or "2"
            if v not in hzc816.OPTS:
                die(f"unknown optimisation {a} (use -O0, -O1, -O2, -O3 or -Os)")
            o["opt"] = v
        elif a == "--stack" or a.startswith("--stack="):
            v = a.split("=", 1)[1] if "=" in a else val("--stack")
            try:
                o["stack"] = int(v, 0)
            except ValueError:
                die(f"--stack needs a number of bytes, not {v}")
        elif a == "--code" or a.startswith("--code="):
            o["code"] = a.split("=", 1)[1] if "=" in a else val("--code")
            if o["code"] not in hzc816.CODES:
                die(f"--code is small or large, not {o['code']}")
        elif a == "--data" or a.startswith("--data="):
            o["data"] = a.split("=", 1)[1] if "=" in a else val("--data")
            if o["data"] not in hzc816.DATAS:
                die(f"--data is near or far, not {o['data']}")
        elif a == "-fdos-keywords":
            o["ccopts"]["dos_keywords"] = True
        elif a == "--sizes":
            o["sizes"] = True
        elif a in ("--heap", "--bank-room", "--main-room", "--spread") or \
                a.split("=", 1)[0] in ("--heap", "--bank-room", "--main-room", "--spread"):
            k = a.split("=", 1)[0]
            v = a.split("=", 1)[1] if "=" in a else val(k)
            try:
                o[k[2:].replace("-", "_")] = int(v, 0)
            except ValueError:
                die(f"{k} needs a number of bytes, not {v}")
        elif a == "-lm":
            pass                            # (math.h is in the C library)
        elif a == "--ui":
            o["ui"] = True
        elif a == "--map":
            o["want_map"] = True
        elif a == "--debug":
            o["debug"] = True
        elif a == "--no-stack-check":
            o["ccopts"]["sscheck"] = 0
        elif a == "-l":
            o["libs"].append(val("-l"))
        elif a == "--game":
            o["game"] = True
        elif a == "--needs" or a.startswith("--needs="):
            o["needs"].append(a.split("=", 1)[1] if a.startswith("--needs=") else val("--needs"))
        elif a == "-v":
            hzc816.VERBOSE = True
        elif a == "--keep":
            o["keep"] = os.path.abspath(val("--keep"))
        elif a.startswith("-"):
            die(f"unknown option {a} (hcc -h lists them)")
        else:
            o["srcs"].append(a)
        i += 1

    if o["code"] not in hzc816.CODES:
        die(f"$HZ_CODE is small or large, not {o['code']}")
    if o["data"] not in hzc816.DATAS:
        die(f"$HZ_DATA is near or far, not {o['data']}")
    if o["data"] == "far" and o["code"] != "large":
        die("--data far needs --code large (far data banks are loaded with the large code "
            "model's banks: docs/c/reference.md, \"The far data model\")")
    srcs = o["srcs"]
    if not srcs:
        die("no source files")
    for s in srcs:
        if not os.path.exists(s):
            die(f"{s}: no such file")
        if os.path.splitext(s)[1].lower() not in (".c", ".s", ".o", ".a", ".lib"):
            die(f"{s}: hcc takes .c, .s, .o and .lib (or .a) files")
    if o["compile_only"] and o["out"] and \
            len([s for s in srcs if not s.endswith((".o", ".a", ".lib"))]) > 1:
        die("-c with -o takes one source")
    if o["needs"]:
        try:
            o["needs"] = parse_needs(",".join(o["needs"]))
        except ValueError as e:
            die(f"--needs: {e}")
    return build(o)


NEED_FLAGS = {"lau": 0x01, "opl2": 0x02, "sprites": 0x04, "blitter": 0x08, "joystick": 0x10}


def parse_needs(text):
    """'horizon=0.29,opl2,mem=1024K' -> {major, minor, rev, flags, kb} (ValueError)"""
    n = {"major": 0, "minor": 0, "rev": 0, "flags": 0, "kb": 0}
    for t in (t.strip().lower() for t in text.split(",")):
        if not t:
            continue
        k, _, v = t.partition("=")
        if k == "horizon":
            parts = v.split(".")
            if len(parts) != 2 or not all(p.isdigit() for p in parts) or \
                    int(parts[0]) > 255 or int(parts[1]) > 255:
                raise ValueError(f"horizon={v}: a version such as 0.29")
            n["major"], n["minor"] = int(parts[0]), int(parts[1])
        elif k == "rev":
            try:
                r = int(v, 0)
            except ValueError:
                raise ValueError(f"rev={v}: a hardware revision number (7 to 255)")
            if not 1 <= r <= 255:
                raise ValueError(f"rev={v}: a hardware revision number (7 to 255)")
            n["rev"] = r
        elif k == "mem":
            m = v.upper()
            mult = 1024 if m.endswith("M") else 1
            m = m.rstrip("KM")
            if not m.isdigit() or not 0 < int(m) * mult <= 65535:
                raise ValueError(f"mem={v}: KB of free memory, such as 1024K or 2M "
                                 f"(65535K at most)")
            n["kb"] = int(m) * mult
        elif k in NEED_FLAGS and not v:
            n["flags"] |= NEED_FLAGS[k]
        else:
            raise ValueError(f"unknown need {t!r} (horizon=X.Y, rev=N, lau, opl2, sprites, "
                             f"blitter, joystick, mem=NK)")
    return n


def needs_object(o, tmp, code):
    """the HZ_NEEDS check as a constructor (an object for the link), or None"""
    n = o["needs"]
    if not n:
        return None
    if hzc816.is_large(code) and (n["major"], n["minor"]) < (0, 28):
        n["major"], n["minor"] = 0, 28          # (its code banks follow the o65: task_path)
    out = o["out"] or os.path.basename(os.path.splitext(o["srcs"][0])[0]).upper() + ".PRG"
    name = os.path.splitext(os.path.basename(out))[0][:15]
    name = "".join(c for c in name if 32 < ord(c) < 127 and c != '"') or "PROGRAM"
    src = os.path.join(tmp, "hzneeds.s")
    with open(src, "w") as f:
        f.write("; hcc --needs: the program's requirements, checked before main\n"
                "\t.p816\n\t.smart\t-\n\t.a16\n\t.i16\n"
                "\t.include \"needs.inc\"\n\t.include \"model.inc\"\n"
                "\t.constructor\t__hz_needs, 30\n"
                "\t.segment\t\"CODE\"\n"
                f"__hz_needs:\n\tHZ_NEEDS \"{name}\", {n['major']}, {n['minor']}, {n['rev']}, "
                f"{n['flags']}, {n['kb']}\n\tRET\n")
    obj = os.path.join(tmp, "hzneeds.o")
    hzc816.assemble(src, obj, code=code)
    return obj


def _env_int(name):
    v = os.environ.get(name)
    try:
        return int(v, 0) if v else None
    except ValueError:
        die(f"${name} is a number of bytes, not {v}")


def compile_all(o, comp, asm):
    """every source to an object (comp: .c, asm: .s); objects and libraries as they are
    -> (objects, tmp dir)"""
    import tempfile
    tmp = tempfile.mkdtemp(prefix="hcc")
    objs = []
    errors = 0
    for n, s in enumerate(o["srcs"]):
        base, ext = os.path.splitext(s)
        ext = ext.lower()
        if ext in (".o", ".a", ".lib"):
            objs.append(s)
            continue
        if o["compile_only"]:
            obj = o["out"] if o["out"] else os.path.basename(base) + ".o"
        else:
            obj = os.path.join(tmp, f"{n}_{os.path.basename(base)}.o")
        try:
            if ext == ".c":
                comp(s, obj, (os.path.basename(base) + ".s") if o["asm_too"] else None)
            else:
                asm(s, obj)
        except HccError as e:
            print(str(e), file=sys.stderr)
            errors += 1
            continue
        objs.append(obj)
    if errors:
        import shutil
        shutil.rmtree(tmp, ignore_errors=True)
        die(f"{errors} file(s) did not compile")
    return objs, tmp


def build(o):
    stack = o["stack"]
    if stack is None:
        stack = hzc816.SSTACK
    if not 512 <= stack <= 0x8000 or stack & 1:
        die("--stack: the software stack is an even number of bytes, 512 to 32768")
    # cc816: the software stack's size (a frame bigger than it is an error)
    o["ccopts"]["sstack"] = stack
    opt = o["opt"] or "2"
    incs = o["incs"]
    code = hzc816.config(o["code"], o["data"])     # small, large or large-far
    if not hzc816.is_large(code) and o["heap"] is not None:
        die("--heap is for the large code model (hcc --code large)")
    tmp = None
    try:
        hzc816.ensure_lib(code)
        objs, tmp = compile_all(
            o, lambda s, obj, a: hzc816.compile_c(s, obj, opt, incs=incs, defs=o["defs"],
                                                  asm_out=a, opts=o["ccopts"], code=code),
            lambda s, obj: hzc816.assemble(s, obj, incs=incs + [os.path.join(hzc816.SDKC,
                                                                               "include")],
                                           code=code))
        if o["compile_only"]:
            return 0
        nobj = needs_object(o, tmp, code)
        if nobj:
            objs = objs + [nobj]
        libs = list(o["libs"])
        if o["game"] or hgbuild.uses_game(o["srcs"]):
            libs.insert(0, hgbuild.lib_for(code))
        out = o["out"] or os.path.basename(os.path.splitext(o["srcs"][0])[0]).upper() + ".PRG"
        mapfile = os.path.splitext(out)[0] + ".map" if o["want_map"] else None
        if o["sizes"]:
            o["keep"] = o["keep"] or os.path.join(tmp, "link")
        ui = o["ui"]
        while True:
            try:
                sizes = hzc816.link(objs, out, sstack=stack, debug=o["debug"], mapfile=mapfile,
                                    extra_libs=libs, keep=o["keep"], ui=ui, code=code,
                                    heap=o["heap"], bank_room=o["bank_room"],
                                    main_room=o["main_room"], spread=o["spread"])
                break
            except HccError as e:
                undef = hzc816.undefined_names(str(e))
                if ui or not undef or not undef <= hzc816.ui_names() | {"hui_rowtramp"}:
                    raise
                ui = True               # only hui.h names missing: the controls library
        if o["want_map"]:
            print(hzc816.size_report(out, sizes))
        if o["sizes"]:
            print(hzc816.object_sizes(out, sizes))
        return 0
    except HccError as e:
        die(str(e))
    finally:
        if tmp:
            import shutil
            shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
