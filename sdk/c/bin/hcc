#!/usr/bin/env python3
"""hcc - build a Horizon program (Atari816) from C, in one command.

    hcc -o GAME.PRG main.c other.c [more.s] [options]

Compiles every .c with vbcc65816, assembles every .s with vasm (vasm oldstyle syntax,
the syntax vbcc emits), links them with the Horizon C library and writes GAME.PRG, ready
for the SD card or the emulator (sdk/tools/run816.py).

Options:
  -o FILE           the program (default: the first source's name in capitals, .PRG)
  -c                compile/assemble only: one .o per source (with -o: that name)
  -S                write the compiler's assembly (.s) next to each .c, then go on
  -I DIR            look for #include files in DIR too
  -D NAME[=VALUE]   define a macro
  -O0 -O1 -O2 -O3 -Os
                    optimisation (default -O1: vbcc's local optimisations; -O2 and -O3
                    add the global ones, which miscompile some code: see
                    docs/c/reference.md, "Compiler notes"; -O3 also -speed, -Os -size)
  --model large     (default) 32-bit pointers: they reach every bank; globals in the
                    code bank, the stack in the window (about 32 KB)
  --model tiny      16-bit pointers, all data in the window: faster, but data + bss +
                    heap are limited to 28,416 bytes (docs/c/reference.md)
  --stack N         tiny model: bytes for the stack (default 3968; data gets the rest)
  --float           link the floating-point library (printf %f, math.h); hcc also
                    adds it by itself when the link needs it
  --ui              link Horizon's controls library (hui.h: windows with buttons,
                    fields, lists, dialogs; large model only); hcc also adds it by
                    itself when the program uses a name of hui.h (docs/c/apps.md)
  --map             write FILE.map (the link map) and print the sizes
  --debug           paint the stack; at exit the program prints how much it used
  -l FILE           link an extra object or library (.o, .a)
  --game            link hgame, the game library (sdk/c/game); hcc also does it by
                    itself when a C source includes <hgame.h>, <conio.h> or <joystick.h>
  -v                show the commands
  --keep DIR        keep the intermediate links in DIR
  --version, -h

Sizes are checked: a program too big for its code bank (or, tiny model, data too big
for the window) is an error that gives the sizes.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "tools"))
import hzc  # noqa: E402
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "game"))
import hgbuild  # noqa: E402

VERSION = "hcc 1.0 (Horizon C SDK, vbcc 65816)"


def die(msg, code=1):
    print(f"hcc: {msg}", file=sys.stderr)
    sys.exit(code)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "--version":
        print(VERSION)
        return 0
    if argv[0] == "--build-lib":            # the SDK's Makefile: (re)build the library
        try:
            for m in argv[1:] or hzc.MODELS:
                hzc.build_lib(m)
        except hzc.HccError as e:
            die(str(e))
        return 0
    if argv[0] == "--build-ui":             # the SDK's Makefile: the controls library
        try:
            hzc.build_ui()
        except hzc.HccError as e:
            die(str(e))
        return 0
    out = None
    srcs, incs, defs, libs = [], [], [], []
    opt = hzc.DEFAULT_OPT
    model = "large"
    compile_only = asm_too = want_map = debug = float_ = ui = False
    game = False
    stack = None
    keep = None
    i = 0

    def val(name):
        nonlocal i
        if i + 1 >= len(argv):
            die(f"{name} needs a value")
        i += 1
        return argv[i]

    while i < len(argv):
        a = argv[i]
        if a == "-o":
            out = val("-o")
        elif a == "-c":
            compile_only = True
        elif a == "-S":
            asm_too = True
        elif a.startswith("-I"):
            incs.append(a[2:] or val("-I"))
        elif a.startswith("-D"):
            defs.append(a[2:] or val("-D"))
        elif a.startswith("-O"):
            o = a[2:] or "2"
            if o not in hzc.OPTS:
                die(f"unknown optimisation {a} (use -O0, -O1, -O2, -O3 or -Os)")
            opt = o
        elif a == "--model" or a.startswith("--model="):
            model = a.split("=", 1)[1] if "=" in a else val("--model")
            if model not in hzc.MODELS:
                die(f"--model is large or tiny, not {model}")
        elif a == "--stack" or a.startswith("--stack="):
            v = a.split("=", 1)[1] if "=" in a else val("--stack")
            try:
                stack = int(v, 0)
            except ValueError:
                die(f"--stack needs a number of bytes, not {v}")
        elif a == "--float" or a == "-lm":
            float_ = True
        elif a == "--ui":
            ui = True
        elif a == "--map":
            want_map = True
        elif a == "--debug":
            debug = True
        elif a == "-l":
            libs.append(val("-l"))
        elif a == "--game":
            game = True
        elif a == "-v":
            hzc.VERBOSE = True
        elif a == "--keep":
            keep = os.path.abspath(val("--keep"))
        elif a.startswith("-"):
            die(f"unknown option {a} (hcc -h lists them)")
        else:
            srcs.append(a)
        i += 1

    if not srcs:
        die("no source files")
    for s in srcs:
        if not os.path.exists(s):
            die(f"{s}: no such file")
        if os.path.splitext(s)[1].lower() not in (".c", ".s", ".o", ".a"):
            die(f"{s}: hcc takes .c, .s (vasm syntax), .o and .a files")
    wend = 0x7000
    if stack is not None:
        if model != "tiny":
            die("--stack is for the tiny model (the large model's stack is the whole "
                "window, about 32 KB)")
        if not 256 <= stack <= 0x7000:
            die("--stack: between 256 and 28672 bytes")
        wend = (0x7F80 - stack) & ~15
    if compile_only and out and len([s for s in srcs if not s.endswith((".o", ".a"))]) > 1:
        die("-c with -o takes one source")
    if ui and model == "tiny":
        die(hzc.UI_TINY)

    tmp = None
    try:
        hzc.vbcc_dir()
        hzc.ensure_lib(model)
        objs = []
        import tempfile
        tmp = tempfile.mkdtemp(prefix="hcc")
        errors = 0
        for n, s in enumerate(srcs):
            base, ext = os.path.splitext(s)
            ext = ext.lower()
            if ext in (".o", ".a"):
                objs.append(s)
                continue
            if compile_only:
                obj = out if out else os.path.basename(base) + ".o"
            else:
                obj = os.path.join(tmp, f"{n}_{os.path.basename(base)}.o")
            try:
                if ext == ".c":
                    hzc.compile_c(s, obj, model, opt=opt, incs=incs, defs=defs,
                                  asm_out=(os.path.basename(base) + ".s") if asm_too else None)
                else:
                    hzc.assemble(s, obj, model, incs=incs + [os.path.join(hzc.SDKC, "include")])
            except hzc.HccError as e:
                print(str(e), file=sys.stderr)
                errors += 1
                continue
            objs.append(obj)
        if errors:
            die(f"{errors} file(s) did not compile")
        if compile_only:
            return 0
        if game or hgbuild.uses_game(srcs):     # the game library (sdk/c/game)
            libs.append(hgbuild.lib_for(model))
        if not out:
            out = os.path.basename(os.path.splitext(srcs[0])[0]).upper() + ".PRG"
        mapfile = os.path.splitext(out)[0] + ".map" if want_map else None
        uinames = set() if ui else None     # the hui.h names used (None: no block)
        while True:
            # a link that misses only floating-point names or hui.h names is done again
            # with the float library or the controls library's block (made for the names)
            try:
                sizes = hzc.link(objs, out, model, float_=float_, wend=wend, debug=debug,
                                 mapfile=mapfile, extra_libs=libs, keep=keep, ui=uinames)
                break
            except hzc.HccError as e:
                msg = str(e)
                undef = hzc.undefined_names(msg)
                huin = undef & hzc.ui_names()
                fl = {n for n in undef if hzc.is_float_name(n)}
                if not undef or undef - huin - fl:
                    raise
                if huin and model == "tiny":
                    die(hzc.UI_TINY)
                if (fl and float_) or (huin and uinames is not None and huin <= uinames):
                    raise
                if fl and not float_:
                    print("hcc: the program uses floating point: linking the float library",
                          file=sys.stderr)
                    float_ = True
                if huin:
                    uinames = (uinames or set()) | huin
        if want_map:
            print(hzc.size_report(out, model, sizes, wend))
        return 0
    except hzc.HccError as e:
        die(str(e))
    finally:
        if tmp:
            import shutil
            shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
