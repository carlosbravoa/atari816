-cc=vbcc65816 -I$VBCC/targets/65816-sim/include -quiet %s -o= %s %s -O=%ld
-ccv=vbcc65816 -I$VBCC/targets/65816-sim/include %s -o= %s %s -O=%ld
-unsigned-char
-as=vasm6502_oldstyle -816 -vobj3 -quiet -nowarn=62 -opt-branch -ldots -Fvobj %s -o %s -ldots
-asv=vasm6502_oldstyle -816 -vobj3 -nowarn=62 -Fvobj -opt-branch -ldots %s -o %s -ldots
-rm=rm %s
-rmv=rm %s
