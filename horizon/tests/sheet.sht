= long chains (one computed through a 998-deep stack)
L999 =L998+1
L2 =L1+1
L1 1
! filld L2:L998
? L999 999
? L500 500
?s L500 =L499+1
M999 1
M1 =M2+1
! filld M1:M998
? M1 999
?s M998 =M999+1

= copy and paste: relative and absolute references
! new
A1 1
A2 2
A3 3
B1 =A1*2
! copy B1 B2
?s B2 =A2*2
? B2 4
B3 =$A$1+A1
! copy B3 C5
?s C5 =$A$1+B3
B4 =SUM(A1:A2)
! copy B4 C6
?s C6 =SUM(B3:B4)
B5 =A$1+$A2
! copy B5 D9
?s D9 =C$1+$A6
B6 =A1
! copy B6 A1
?s A1 =#REF
? A1 #REF
! copy A2:B3 E1
?s E1 2
?s F1 =E1*2
?s F2 =$A$1+#REF
! copy B2 G1:G3
?s G1 =F1*2
?s G3 =F3*2
! cut A3 H1
? H1 3
? A3
?s B4 =SUM(A1:A2)

= fill down and fill right
! new
A1 5
A2 6
B1 =A1+1
! filld B1:B3
?s B2 =A2+1
?s B3 =A3+1
? B2 7
C1 =$A$1*B1
! filld C1:C2
?s C2 =$A$1*B2
D1 =A1
! fillr D1:F1
?s E1 =B1
?s F1 =C1
G1 hello
! filld G1:G3
? G3 hello
! clear G1:G3
? G2

= insert and delete rows and columns: references follow
! new
A1 1
A2 2
A3 3
A4 =SUM(A1:A3)
B1 =A3*2
B2 =$A$2
! insr 2
?s A5 =SUM(A1:A4)
? A5 6
?s B1 =A4*2
? B1 6
?s B3 =$A$3
? A2
! delr 4
?s A4 =SUM(A1:A3)
? A4 3
?s B1 =#REF*2
? B1 #REF
! delr 1
?s A3 =SUM(A1:A2)
? A3 2
! insc A
?s B3 =SUM(B1:B2)
? B3 2
?s C2 =$B$2
! delc B
?s B2 =#REF
? B2 #REF
C1 7
C2 =C1+1
! delc A
?s B2 =B1+1
? B2 8
! insr 1
?s B3 =B2+1
? B3 8

= ranges at the edges of a deleted block
! new
A1 1
A2 2
A3 3
B1 =SUM(A2:A2)
B4 =SUM(A1:A3)
! delr 2
?s B1 =SUM(#REF)
? B1 #REF
?s B3 =SUM(A1:A2)
? B3 4

= files: .SHT round trip
! new
W B 100
F B 2T
F C P
A1 Budget
A2 =A1
B1 1234.5
B2 =B1*2
C1 0.125
C2 'x, "quoted"
A3 '=not a formula
! save /T.SHT
! new
! load /T.SHT
? A1 Budget
?f B1 1,234.50
?f B2 2,469.00
?f C1 12.5%
? C2 x, "quoted"
?s A3 '=not a formula
? A2 #VALUE

= files: CSV round trip
! new
A1 Name
B1 Value
A2 a, b
B2 1.5
A3 say "hi"
B3 =B2*2
A4  spaces
B4 =1/0
C5 -3
! csvout /T.CSV
! new
! csvin /T.CSV
? A2 a, b
?s B3 3
? A3 say "hi"
? A4  spaces
? B4 #DIV/0
?s B4 #DIV/0
? C5 -3
? C1

