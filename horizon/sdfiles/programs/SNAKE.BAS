10 REM SNAKE.BAS - steer with the arrow keys (W A S D, or joystick 1), eat the red squares; Esc stops
20 SCREEN 320,200:RANDOMIZE
30 W=32:H=20:N=640:DIM X(639),Y(639),B(31,19)
40 HI=0
50 PRINT "Snake: arrow keys, W A S D or joystick 1; Esc stops"
100 REM a new game
110 GCLS 0:COLOR 8:RECT 0,0,320,200
120 FOR I=0 TO W-1:FOR J=0 TO H-1:B(I,J)=0:NEXT J,I
130 TI=0:HD=2:DX=1:DY=0:SC=0
140 FOR I=0 TO 2:X(I)=8+I:Y(I)=10:B(8+I,10)=1:COLOR 46:FRECT X(I)*10+1,100+1,8,8:NEXT
150 GOSUB 600
200 REM the game loop
210 K$=INKEY$
220 IF K$=CHR$(129) OR K$="a" THEN IF DX=0 THEN DX=-1:DY=0
230 IF K$=CHR$(128) OR K$="d" THEN IF DX=0 THEN DX=1:DY=0
240 IF K$=CHR$(131) OR K$="w" THEN IF DY=0 THEN DX=0:DY=-1
250 IF K$=CHR$(130) OR K$="s" THEN IF DY=0 THEN DX=0:DY=1
252 S=STICK(0)
253 IF S=11 AND DX=0 THEN DX=-1:DY=0
254 IF S=7 AND DX=0 THEN DX=1:DY=0
256 IF S=14 AND DY=0 THEN DX=0:DY=-1
257 IF S=13 AND DY=0 THEN DX=0:DY=1
260 NX=X(HD)+DX:NY=Y(HD)+DY
270 IF NX<0 OR NX>=W OR NY<0 OR NY>=H THEN 800
280 IF B(NX,NY) THEN 800
290 COLOR 40:FRECT X(HD)*10+1,Y(HD)*10+1,8,8
300 HD=(HD+1) MOD N:X(HD)=NX:Y(HD)=NY:B(NX,NY)=1
310 COLOR 46:FRECT NX*10+1,NY*10+1,8,8
320 IF NX=FX AND NY=FY THEN SC=SC+1:SOUND 0,1200,8:GOSUB 600:GOTO 350
330 B(X(TI),Y(TI))=0:COLOR 0:FRECT X(TI)*10+1,Y(TI)*10+1,8,8
340 TI=(TI+1) MOD N
350 PAUSE 90-MIN(SC*3,60):SOUND 0,0,0
360 GOTO 210
600 REM food in a free place
610 FX=RND(W):FY=RND(H):IF B(FX,FY) THEN 610
620 COLOR 196:FRECT FX*10+2,FY*10+2,6,6
630 RETURN
800 REM game over
810 FOR F=600 TO 100 STEP -50:SOUND 0,F,10:PAUSE 30:NEXT:SOUND
820 IF SC>HI THEN HI=SC
830 COLOR 1:TEXT 124,84,"GAME OVER":TEXT 100,100,"score "+STR$(SC)+"  best "+STR$(HI)
840 TEXT 76,116,"any key: again, Esc: stop"
850 PRINT "Score ";SC;", best ";HI
860 PAUSE 500:K$=INKEY$
870 IF INKEY$="" THEN PAUSE 20:GOTO 870
880 GOTO 100
