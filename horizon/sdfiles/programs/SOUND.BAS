10 REM SOUND.BAS - POKEY 2 from BASIC: a scale, a chord, a tune, a siren
20 REM SOUND voice, Hz, volume (voices 0-3, volume 0-15); SOUND alone: all quiet
30 PRINT "A scale:";
40 RESTORE 500
50 FOR I=1 TO 8:READ N$,F:PRINT " ";N$;:SOUND 0,F,10:PAUSE 250:NEXT I
60 SOUND:PRINT
70 PRINT "A chord (three voices)":SOUND 0,262,8:SOUND 1,330,8:SOUND 2,392,8:PAUSE 1000:SOUND
80 PRINT "A tune"
90 RESTORE 600
100 READ F,D:IF D=0 THEN 130
110 SOUND 0,F,10:PAUSE D-20:SOUND 0,0,0:PAUSE 20
120 GOTO 100
130 PRINT "A siren":FOR R=1 TO 3
140 FOR F=400 TO 1200 STEP 40:SOUND 0,F,8:PAUSE 15:NEXT
150 FOR F=1200 TO 400 STEP -40:SOUND 0,F,8:PAUSE 15:NEXT
160 NEXT R:SOUND
170 PRINT "BEEP":BEEP:PAUSE 300:BEEP 440,300
180 END
500 DATA C,262,D,294,E,330,F,349,G,392,A,440,B,494,C,523
600 DATA 392,200,392,200,440,400,392,400,523,400,494,800
610 DATA 392,200,392,200,440,400,392,400,587,400,523,800,0,0
