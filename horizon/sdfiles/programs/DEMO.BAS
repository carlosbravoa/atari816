10 REM DEMO.BAS - lines, circles and colours
20 REM colour 16+36*R+6*G+B: a cube (R, G, B 0-5)
30 SCREEN 320,200:RANDOMIZE 1
40 REM a sky of 35 PALETTE entries, 4 lines each
50 FOR I=0 TO 34:PALETTE 100+I,8+I*7,12+I*4,60+I
60 COLOR 100+I:FRECT 0,I*4,320,4:NEXT
70 FOR I=1 TO 60:COLOR 255-RND(10)
80 PLOT RND(320),RND(60):NEXT
90 REM the sun: a disc a row at a time, rings
100 R=26:FOR Y=-R TO R:X=R
110 WHILE X*X+Y*Y>R*R:X=X-1:WEND
120 COLOR 226:LINE 160-X,118+Y,160+X,118+Y:NEXT
130 FOR R=31 TO 43 STEP 6:COLOR 220:CIRCLE 160,118,R:NEXT
140 REM hills from DATA, filled down to the sea
150 READ X0,Y0:FOR I=1 TO 8:READ X1,Y1
160 FOR X=X0 TO X1:Y=Y0+(Y1-Y0)*(X-X0)/(X1-X0)
170 COLOR 54:LINE X,Y,X,139:NEXT X
180 COLOR 92:LINE X0,Y0,X1,Y1:X0=X1:Y0=Y1:NEXT I
190 DATA 0,118,40,102,84,114,120,104,146,132
200 DATA 190,130,232,96,280,110,319,100
210 REM the sea and the sun's reflection
220 COLOR 17:FRECT 0,140,320,60
230 FOR Y=142 TO 182 STEP 4:W=34-(Y-140)/2
240 COLOR 214:LINE 160-W,Y,160+W,Y
250 COLOR 220:LINE 160-W/2,Y+1,160+W/2,Y+1:NEXT
260 COLOR 1:TEXT 108,186,"Horizon BASIC"
270 PRINT "Press a key (Esc stops)"
280 IF INKEY$="" THEN PAUSE 20:GOTO 280
