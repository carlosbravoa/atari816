10 REM PLOT.BAS - a function plotter: three curves over a grid, with axes and labels
20 W=480:H=240:SCREEN W,H:GCLS 0
30 X0=-2*PI:X1=2*PI:Y0=-1.5:Y1=1.5:REM the part of the plane shown
40 SX=W/(X1-X0):SY=H/(Y1-Y0)
50 COLOR 236:FOR K=-4 TO 4:X=K*PI/2:GOSUB 500:LINE PX,0,PX,H-1:NEXT
60 FOR Y=-1 TO 1 STEP 0.5:GOSUB 510:LINE 0,PY,W-1,PY:NEXT
70 COLOR 250:X=0:Y=0:GOSUB 500:GOSUB 510:LINE 0,PY,W-1,PY:LINE PX,0,PX,H-1
80 COLOR 1:TEXT PX+4,PY+2,"0":Y=1:GOSUB 510:TEXT PX+4,PY+2,"1":Y=-1:GOSUB 510:TEXT PX+4,PY-13,"-1"
90 Y=0:GOSUB 510:X=-PI:GOSUB 500:TEXT PX-12,PY+2,"-PI":X=PI:GOSUB 500:TEXT PX-8,PY+2,"PI"
100 F=1:C=13:GOSUB 200:F=2:C=14:GOSUB 200:F=3:C=45:GOSUB 200
110 COLOR 13:TEXT 8,4,"SIN(X)":COLOR 14:TEXT 8,16,"COS(X)":COLOR 45:TEXT 8,28,"SIN(3X)*EXP(-ABS(X)/3)"
120 PRINT "Press a key":K$="":WHILE K$="":K$=INKEY$:WEND
130 END
200 REM curve F in colour C: one point a pixel, joined by lines
210 COLOR C:FOR PX=0 TO W-1:X=X0+PX/SX
220 ON F GOSUB 300,310,320
230 GOSUB 510:IF PX>0 THEN LINE LX,LY,PX,PY
240 LX=PX:LY=PY:NEXT:RETURN
300 Y=SIN(X):RETURN
310 Y=COS(X):RETURN
320 Y=SIN(3*X)*EXP(-ABS(X)/3):RETURN
500 PX=(X-X0)*SX:RETURN
510 PY=(Y1-Y)*SY:RETURN
