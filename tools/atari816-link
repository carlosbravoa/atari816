"""atari816-link - the PC side of the Atari816 PC link.

Shares ONE folder of this computer with the Atari816 over its USB cable. On the Atari816 the
folder is the volume /PC: (a "PC" icon on the desktop). It also gives the Atari816 the time,
and lets the developer tools (core/tools/atari.py) reach the board while it runs.

    atari816-link                 # share ~/Atari816 (created if missing)
    atari816-link ~/games         # share another folder
    atari816-link --read-only     # the Atari816 may read, not change anything
    atari816-link --port /dev/ttyUSB1

Safety: only that folder is shared, never anything outside it ('..', hidden names and links
that point out of it are refused). The gateway opens no network port: the tools talk to it
through a Unix socket in your runtime folder that only you can use. Stop it with Ctrl-C.

Needs Python 3 and pyserial (pip install pyserial). Linux: you must be allowed to use the
serial port (group "dialout"). Stop the gateway before loading a bitstream with
openFPGALoader (they share the board's USB).
"""
import argparse
import os
import signal
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import pclink  # noqa: E402


def main():
    ap = argparse.ArgumentParser(prog="atari816-link", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("folder", nargs="?", default=os.path.expanduser("~/Atari816"),
                    help="the folder to share (default ~/Atari816)")
    ap.add_argument("-p", "--port", default=None, help="serial port (default: found by itself)")
    ap.add_argument("--read-only", action="store_true", help="the Atari816 may not change files")
    ap.add_argument("--log", default=None, help="append the board's log to this file")
    ap.add_argument("-v", "--verbose", action="count", default=0,
                    help="say more (-vv: every file opened)")
    args = ap.parse_args()
    folder = os.path.abspath(os.path.expanduser(args.folder))
    if not os.path.exists(folder):
        os.makedirs(folder)
        print(f"created {folder}")
    logfile = open(args.log, "a") if args.log else None

    def stop(sig, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, stop)          # kill / systemd: leave cleanly (BYE) too
    signal.signal(signal.SIGINT, stop)
    try:
        gw = pclink.Gateway(folder, port=args.port, readonly=args.read_only,
                            verbose=args.verbose + 1, logfile=logfile)
        gw.run()
    except KeyboardInterrupt:
        print("\nstopped")
    except pclink.LinkError as e:
        sys.exit(f"atari816-link: {e}")


if __name__ == "__main__":
    main()
