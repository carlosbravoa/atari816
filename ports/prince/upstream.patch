 #define REPLAY_FORMAT_DEPRECATION_NUMBER 2   // SDLPoP won't open replays with a higher deprecation number
 // If deprecation_number >= 2: Waste an RNG cycle in loose_shake() to match DOS PoP.
 
+#if defined(_HORIZON)
+// Horizon: the moves in a bank of their own (one object is at most 64 KB): 91 minutes
+#define MAX_REPLAY_DURATION 61440
+static byte __far *moves; // and at 61440 the savestate (4 KB)
+static int moves_bank(void) {
+	if (moves == NULL) moves = (byte __far *)hz_far_alloc();
+	return moves != NULL;
+}
+static size_t fread_far(byte __far *dst, size_t n, FILE* fp) {
+	byte buf[256];
+	size_t done = 0;
+	while (done < n) {
+		size_t k = n - done > sizeof(buf) ? sizeof(buf) : n - done;
+		if (fread(buf, 1, k, fp) != k) break;
+		hz_far_copy(dst + done, buf, (unsigned)k);
+		done += k;
+	}
+	return done == n ? 1 : 0;
+}
+static void fwrite_far(const byte __far *src, size_t n, FILE* fp) {
+	byte buf[256];
+	size_t done = 0;
+	while (done < n) {
+		size_t k = n - done > sizeof(buf) ? sizeof(buf) : n - done;
+		hz_far_copy(buf, src + done, (unsigned)k);
+		fwrite(buf, 1, k, fp);
+		done += k;
+	}
+}
+#else
 #define MAX_REPLAY_DURATION 345600 // 8 hours: 720 * 60 * 8 ticks
 byte moves[MAX_REPLAY_DURATION] = {0}; // static memory for now because it is easier (should this be dynamic?)
+#endif
 
