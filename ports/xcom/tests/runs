# The test runs (make test, tests/check.sh): NAME  the engine's options. Each runs
# tests/NAME.keys (upstream's KEYS script) on the host (the reference) and on the Atari816
# in the emulator (with /V: the virtual clock), and the two must give the same LOG, the
# same pictures at the same virtual times, the same files. NAME: at most 8 characters.
geo        VGA NOINTRO LOG GEO.TXT
battle     VGA NOINTRO BATTLE SEED 1 MISSION FA1V.PAK RACE RSV.PAK LOG BATTLE.TXT
save       VGA NOINTRO LOG SAVE.TXT
bench      VGA NOINTRO BENCH MISSION FA1V.PAK RACE RSV.PAK LOG BENCHLOG.TXT
bsave      s=500 VGA NOINTRO BATTLE SEED 1 MISSION FA1V.PAK RACE RSV.PAK LOG BSAVE.TXT
intro      VGA INTRO LOG INTRO.TXT
endwin     VGA NOINTRO ENDTEST 1 LOG ENDWIN.TXT
base1      VGA NOINTRO LOG BASE1.TXT
base2      VGA NOINTRO LOG BASE2.TXT
geobtn     VGA NOINTRO LOG GEOBTN.TXT
dogfight   VGA NOINTRO SEED 2 LOG DOGFIGHT.TXT
mission    VGA NOINTRO TERROR LOG MISSION.TXT
bturn      VGA NOINTRO BATTLE SEED 3 MISSION FA3V.PAK RACE RSV.PAK GEAR LOG BTURN.TXT
bfire      VGA NOINTRO BATTLE SEED 6 MISSION FA1V.PAK RACE RSV.PAK LOG BFIRE.TXT
night      VGA NOINTRO BATTLE SEED 1 MISSION FA1V.PAK RACE RSV.PAK NIGHT LOG NIGHT.TXT
# the same on a board without the colour remap (REV $0C): the CPU shades, the same pictures
night12    k=night r=12 VGA NOINTRO BATTLE SEED 1 MISSION FA1V.PAK RACE RSV.PAK NIGHT LOG NIGHT.TXT
